{
  "name": "election-navigator-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.0",
    "@google/genai": "^1.0.1",
    "@react-google-maps/api": "^2.20.8",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.1",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.11.0",
    "jspdf": "^4.2.1",
    "next": "^16.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.module\\.css$": "<rootDir>/__mocks__/styleMock.js",
      "\\.css$": "<rootDir>/__mocks__/styleMock.js",
      "^firebase/app$": "<rootDir>/__mocks__/firebaseApp.js",
      "^firebase/firestore$": "<rootDir>/__mocks__/firebaseFirestore.js",
      "^@google-cloud/bigquery$": "<rootDir>/__mocks__/bigquery.js",
      "^uuid$": "<rootDir>/__mocks__/uuid.js",
      "^html2canvas$": "<rootDir>/__mocks__/html2canvas.js",
      "^jspdf$": "<rootDir>/__mocks__/jspdf.js",
      "^react-markdown$": "<rootDir>/__mocks__/react-markdown.js"
    },
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": [
        "babel-jest",
        {
          "presets": [
            "next/babel"
          ]
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx|js)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/"
    ]
  }
}
